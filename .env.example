# Georgian fine-tune of multilingual Whisper turbo, pinned by download-model.py.
# One human fixture passed; representative live-speaker validation is still required.
WHISPER_MODEL=models/georgian-turbo
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_THREADS=4
MODEL_DOWNLOAD_ROOT=models
MODEL_LOCAL_ONLY=true
ESPEAK_PATH=tools/espeak-ng/espeak-ng.exe
MAX_AUDIO_SECONDS=30
MAX_AUDIO_BYTES=6000000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
# Optional verified HTTPS base URL; leave blank for local demonstration.
PUBLIC_BASE_URL=
PUBLIC_URL_VERIFIED=false

# Local neural Georgian voice, no Windows speech voice.
TTS_ENGINE=piper
PIPER_MODEL=models/piper/ka/ka_GE/natia/medium/ka_GE-natia-medium.onnx
